# Zammad MCP Server Configuration

# Zammad instance URL (required)
ZAMMAD_URL=https://your-instance.zammad.com/api/v1

# Authentication - choose one of the following methods:

# Option 1: API Token (recommended)
ZAMMAD_HTTP_TOKEN=your-api-token-here

# Option 2: OAuth2 Token
# ZAMMAD_OAUTH2_TOKEN=your-oauth2-token-here

# Option 3: Username and Password
# ZAMMAD_USERNAME=your-username
# ZAMMAD_PASSWORD=your-password

# Optional: Disable TLS certificate verification (NOT recommended for production)
# Use only for self-signed/internal cert chains when you trust the network path.
# Truthy values only: 1, true, yes, on. Unset (default) keeps TLS verification enabled.
# ZAMMAD_INSECURE=true

# Optional: Logging level (default: INFO)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# === Transport Configuration ===

# Transport type: stdio (default) or http
# MCP_TRANSPORT=stdio

# HTTP Transport Settings (required if MCP_TRANSPORT=http)
# Host to bind to (default: 127.0.0.1)
# MCP_HOST=127.0.0.1

# Port to listen on (required for HTTP transport)
# MCP_PORT=8000

# === OAuth / Bearer Auth (optional) ===
# Set these to enable OAuth2 token validation via an external IdP (e.g. Authentik).
# When set, FastMCP will validate incoming Bearer tokens and expose
# /.well-known/oauth-protected-resource and /.well-known/oauth-authorization-server.

# OIDC issuer URL (must end with /)
# OAUTH_ISSUER=https://authentik.example.com/application/o/zammad-mcp/

# Expected audience claim in the JWT
# OAUTH_AUDIENCE=zammad-mcp

# Public base URL of this MCP server (used as resource_server_url)
# MCP_BASE_URL=https://helpdesk-mcp.example.com
